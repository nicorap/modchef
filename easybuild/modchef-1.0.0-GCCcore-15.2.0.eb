easyblock = 'PythonPackage'

name = 'modchef'
version = '1.0.0'

homepage = 'https://github.com/nicorap/modchef'
description = "Cook EasyBuild environments from software ingredients."

# Pick the GCCcore version whose Python your other interactive tooling already
# uses. Loading modchef next to a module built on a different Python means two
# Pythons in one environment, and the one that wins depends on load order.
toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

sources = [SOURCE_TAR_GZ]

# No checksum is pinned here on purpose: build the tarball from a checkout
# (`python -m build`) and the bytes differ per build, so any value shipped in
# this file would be wrong for you. Add yours once, with:
#     eb modchef-1.0.0-GCCcore-15.2.0.eb --inject-checksums
# Once modchef is on PyPI you can instead point at the release and pin its
# published hash:
#     source_urls = [PYPI_SOURCE]

dependencies = [
    ('Python', '3.14.2'),
    ('PyYAML', '6.0.3'),
    ('RDFlib', '7.6.0'),
]

use_pip = True
download_dep_fail = True
sanity_pip_check = True

sanity_check_paths = {
    'files': ['bin/modchef', 'bin/modchef-index'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/modchef'],
}

sanity_check_commands = [
    'python -c "import modchef"',
    "modchef --help",
]

# SITE-SPECIFIC: where the modchef-index cron writes the daily graph. The
# runtime CLI reads it from $MODCHEF_TTL, so point this at a path your users
# can read and your EasyBuild admin can write. Change it before installing.
modextravars = {'MODCHEF_TTL': '/opt/easybuild/modchef/modchef.ttl'}

moduleclass = 'tools'
